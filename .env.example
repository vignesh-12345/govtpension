# Sewa Setu — environment variables
# Copy to .env and fill in before running docker compose up

# The public HTTPS URL of this deployment — stamped into OAuth tokens and
# MCP server discovery documents. Must match the domain your HTTPS cert covers.
PUBLIC_BASE_URL=https://sewasetu.yourdomain.in

# Admin login password (username is always "admin")
ADMIN_PASSWORD=change-me-before-deploying

# Flask session secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-random-secret
